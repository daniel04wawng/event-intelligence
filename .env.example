# Copy this file to .env and fill in real values.
# .env is gitignored — never commit credentials.

# Anthropic API key — enables LLM-driven audience design and web-search
# candidate curation. Without this the pipeline still runs but uses the
# generic fallback persona library and produces zero curated prospects.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string. Get this from Supabase project settings:
#   Project Settings → Database → Connection string → URI (with sslmode=require)
# Looks like:
#   postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Without DATABASE_URL the pipeline runs file-based only (data/ + logs/).
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@host:6543/postgres
